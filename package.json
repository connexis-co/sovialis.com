{
  "name": "sovialis-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio público de Sovialis (cuidado del adulto mayor en Bogotá) sobre EmDash + Astro en Cloudflare Workers.",
  "engines": {
    "node": ">=22.12.0"
  },
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-typegen": "wrangler types",
    "deploy": "node scripts/deploy.mjs",
    "seed:build": "node scripts/build-seed.mjs",
    "content:sync": "node scripts/sync-content.mjs",
    "sitemap:submit": "node scripts/submit-sitemaps.mjs",
    "prepare": "husky",
    "deploy:secrets": "node scripts/deploy.mjs --secrets",
    "content:validate": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/react": "6.0.6",
    "@emdash-cms/cloudflare": "1.1.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "emdash": "1.1.0",
    "jose": "6.2.12",
    "lucide-react": "1.52.0",
    "lucide-static": "1.52.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "5.20261002.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "^5.9.3",
    "wrangler": "4.147.0",
    "yaml": "2.9.1"
  }
}
