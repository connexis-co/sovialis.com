{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sovialis-web",
  "main": "./src/worker.ts",
  "account_id": "104bb1d9de543f588ab0537c9d381516",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "sovialis.com", "custom_domain": true },
    { "pattern": "www.sovialis.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sovialis-web",
      "database_id": "257b4b11-5ba3-452d-b8d9-a4cb42d52588"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sovialis-web-media"
    },
    // Sesiones de Astro/EmDash en R2 (1 M escrituras/mes gratis; KV solo admite 1.000 al día).
    // Se llama SESSION a propósito: el adaptador de Cloudflare inyecta env.SESSION como almacén de
    // sesiones. El bucket expira objetos a los 30 días (regla «expirar-sesiones»).
    {
      "binding": "SESSION",
      "bucket_name": "sovialis-web-sessions"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "9eef230f0b144e8d88bde3d200062e02" }
  ],
  // Correo saliente de Cloudflare (Email Routing / Email Service). Con Email Routing solo entrega a
  // direcciones verificadas de la cuenta (avisos internos de leads). El remitente debe ser @sovialis.com.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "SOVIALIS_ENV": "production",
    "EMDASH_SITE_URL": "https://sovialis.com",
    // Cloudflare Access (panel /_emdash/admin): equipo y audiencia de la aplicación «Sovialis · Web (panel EmDash)».
    "CF_ACCESS_TEAM_DOMAIN": "holy-king-fdc9.cloudflareaccess.com",
    "CF_ACCESS_AUDIENCE": "cab13b1a85efeb6ae0af0d6a79d212703a56d9f1a0c907fea2e240e7b5d2ea78",
    "ADMIN_EMAILS": "connexis.co@gmail.com,equipo.sovialis@gmail.com",
    "ADMIN_NAMES": "connexis.co@gmail.com=JP Misat;equipo.sovialis@gmail.com=Eilin Dayanna"
  },
  // Mantenimiento de EmDash (publicaciones programadas, cron de plugins).
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
