{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sovialis-web",
  "main": "./src/worker.ts",
  "account_id": "104bb1d9de543f588ab0537c9d381516",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "sovialis.com", "custom_domain": true },
    { "pattern": "www.sovialis.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sovialis-web",
      "database_id": "257b4b11-5ba3-452d-b8d9-a4cb42d52588"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sovialis-web-media"
    }
  ],
  "kv_namespaces": [
    { "binding": "SESSION", "id": "dae5053ae0e34c90955aa5784c99530d" },
    { "binding": "CACHE", "id": "9eef230f0b144e8d88bde3d200062e02" }
  ],
  // Correo saliente de Cloudflare (Email Routing / Email Service). Con Email Routing solo entrega a
  // direcciones verificadas de la cuenta (avisos internos de leads). El remitente debe ser @sovialis.com.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "SOVIALIS_ENV": "production",
    "EMDASH_SITE_URL": "https://sovialis.com"
  },
  // Mantenimiento de EmDash (publicaciones programadas, cron de plugins).
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
