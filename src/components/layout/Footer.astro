---
/** Pie redondeado en Azul Tinta con la S del isotipo como marca de agua, NAP, menús editables y nota legal. */
import { getMenu } from "emdash";
import BrandS from "../ui/BrandS.astro";
import Logo from "../ui/Logo.astro";
import { icon } from "../../lib/icons";
import { HUBS, ROUTES } from "../../lib/routes";
import { telLink, waLink, type CatalogItem, type SiteData } from "../../lib/site";

interface Props {
	site: SiteData;
	services: CatalogItem[];
	zones: CatalogItem[];
}
const { site, services, zones } = Astro.props;
const [company, legal] = await Promise.all([getMenu("footer_empresa").catch(() => null), getMenu("footer_legal").catch(() => null)]);
const companyLinks = company?.items?.length
	? company.items.map((i) => ({ label: i.label, href: i.url }))
	: [
			{ label: "Nosotros", href: "/nosotros/" },
			{ label: "Cómo funciona", href: "/como-funciona/" },
			{ label: "Precios", href: HUBS.prices },
			{ label: "Guías para familias", href: HUBS.blog },
			{ label: "Trabaja con nosotros", href: "/trabaja-con-nosotros/" },
			{ label: "Contacto", href: HUBS.contact },
		];
const legalLinks = legal?.items?.length
	? legal.items.map((i) => ({ label: i.label, href: i.url }))
	: [
			{ label: "Política de tratamiento de datos", href: "/politica-de-tratamiento-de-datos/" },
			{ label: "Términos y condiciones", href: "/terminos-y-condiciones/" },
			{ label: "Política de cookies", href: "/politica-de-cookies/" },
		];
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark relative mt-0 overflow-hidden bg-deep text-white">
	<BrandS class="pointer-events-none absolute -top-16 -right-24 h-[34rem] w-auto text-[#8fd8f2] opacity-[0.08] sm:-right-10 lg:h-[40rem]" />
	<div class="container-page relative pt-16 pb-10 lg:pt-20">
		<div class="grid gap-12 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
			<div class="max-w-sm">
				<Logo variant="negativo" class="h-10 w-auto" />
				<p class="mt-3 font-display text-lg text-[#8fd8f2]">{site.tagline}</p>
				<p class="mt-4 text-white/80">{site.footerAbout}</p>
				<ul class="mt-6 grid gap-3 text-[1.02rem]">
					<li>
						<a href={telLink(site)} class="flex items-center gap-3 hover:underline" data-cta="global:pie-llamar">
							<Fragment set:html={icon("telefono", "size-5 text-[#8fd8f2]")} />
							{site.phoneDisplay}
						</a>
					</li>
					<li>
						<a href={waLink(site)} data-wa data-cta="global:pie-whatsapp" class="flex items-center gap-3 hover:underline" target="_blank" rel="noopener">
							<Fragment set:html={icon("whatsapp", "size-5 text-[#8fd8f2]")} />
							WhatsApp {site.whatsappDisplay}
						</a>
					</li>
					<li>
						<a href={`mailto:${site.email}`} class="flex items-center gap-3 hover:underline">
							<Fragment set:html={icon("correo", "size-5 text-[#8fd8f2]")} />
							{site.email}
						</a>
					</li>
					<li class="flex items-start gap-3 text-white/80">
						<Fragment set:html={icon("reloj", "size-5 mt-0.5 text-[#8fd8f2]")} />
						{site.hours}
					</li>
				</ul>
				{
					site.social.length > 0 && (
						<ul class="mt-6 flex flex-wrap gap-3">
							{site.social.map((s) => (
								<li>
									<a href={s.url} class="chip !border-white/20 !bg-white/5 text-white" rel="noopener me" target="_blank">
										{s.name}
									</a>
								</li>
							))}
						</ul>
					)
				}
			</div>

			<nav aria-label="Servicios">
				<p class="footer-heading">Servicios</p>
				<ul class="footer-list">
					{
						services.map((s) => (
							<li>
								<a href={ROUTES.services(s.slug)}>{s.shortTitle}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-label="Zonas de cobertura">
				<p class="footer-heading">Zonas</p>
				<ul class="footer-list">
					{
						zones.slice(0, 10).map((z) => (
							<li>
								<a href={z.url}>{z.shortTitle}</a>
							</li>
						))
					}
					<li><a href={HUBS.zones} class="font-semibold text-[#8fd8f2]">Ver cobertura completa</a></li>
				</ul>
			</nav>

			<nav aria-label="Sovialis">
				<p class="footer-heading">Sovialis</p>
				<ul class="footer-list">
					{
						companyLinks.map((l) => (
							<li>
								<a href={l.href}>{l.label}</a>
							</li>
						))
					}
				</ul>
				<p class="footer-heading mt-8">Legal</p>
				<ul class="footer-list">
					{
						legalLinks.map((l) => (
							<li>
								<a href={l.href}>{l.label}</a>
							</li>
						))
					}
					<li><button type="button" class="text-left hover:underline" onclick="document.dispatchEvent(new Event('sv:open-cookies'))">Preferencias de cookies</button></li>
				</ul>
			</nav>
		</div>

		<div class="mt-14 border-t border-white/15 pt-8 text-[0.95rem] text-white/70">
			<p class="max-w-4xl">{site.footerLegal}</p>
			<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
				<p>© {year} {site.legalName || site.name}{site.nit ? ` · NIT ${site.nit}` : ""}. Imágenes ilustrativas.</p>
				<p>
					Sitio desarrollado por <a href="https://connexis.co" class="font-semibold text-white hover:underline" rel="noopener">Connexis</a>
				</p>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-radius: var(--sv-radius-hero) var(--sv-radius-hero) 0 0;
		background-image: var(--sv-gradient-deep);
	}
	.footer-heading {
		font-family: var(--sv-font-display);
		font-size: 1.35rem;
		font-weight: 500;
		margin-bottom: 1rem;
	}
	.footer-list {
		display: grid;
		gap: 0.65rem;
	}
	.footer-list a {
		color: rgb(255 255 255 / 0.85);
		text-decoration: none;
		transition: color var(--sv-dur);
	}
	.footer-list a:hover {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
</style>
