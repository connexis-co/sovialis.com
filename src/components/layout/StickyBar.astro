---
/** Barra fija inferior en móvil: Llamar + WhatsApp. Aparece cuando el CTA del hero sale de pantalla. */
import { icon } from "../../lib/icons";
import { telLink, waLink, type SiteData } from "../../lib/site";

interface Props {
	site: SiteData;
	always?: boolean;
}
const { site, always = false } = Astro.props;
---

<div class="cta-bar" data-cta-bar data-always={always ? "true" : undefined} role="region" aria-label="Contacto rápido">
	<a class="cta-bar__call" href={telLink(site)} data-cta="global:barra-movil-llamar" aria-label={`Llamar a Sovialis al ${site.phoneDisplay}`}>
		<Fragment set:html={icon("telefono", "size-6")} />
	</a>
	<a class="btn btn-whatsapp cta-bar__wa" href={waLink(site)} data-wa data-cta="global:barra-movil" target="_blank" rel="noopener">
		<Fragment set:html={icon("whatsapp", "size-6")} />
		<span class="flex flex-col items-start leading-tight">
			<span class="text-[1.02rem] font-bold">{site.stickyTitle}</span>
			<span class="text-[0.85rem] font-semibold opacity-80">{site.stickyText}</span>
		</span>
	</a>
</div>

<style>
	.cta-bar {
		display: none;
	}
	@media (max-width: 1023px) {
		:global(html.has-sticky-cta) :global(body) {
			padding-block-end: calc(var(--sv-sticky-cta-h) + env(safe-area-inset-bottom));
		}
		.cta-bar {
			position: fixed;
			inset: auto 0 var(--alto-consentimiento, 0px);
			z-index: 40;
			display: flex;
			gap: 12px;
			align-items: center;
			padding: 8px 16px calc(8px + env(safe-area-inset-bottom));
			background: var(--sv-surface);
			border-top: 1px solid var(--sv-border);
			box-shadow: 0 -4px 20px #0b2a4e1f;
			transform: translateY(100%);
			visibility: hidden;
			transition:
				transform var(--sv-dur) var(--sv-ease-out),
				visibility 0s linear var(--sv-dur);
		}
		.cta-bar.is-visible {
			transform: none;
			visibility: visible;
			transition-delay: 0s;
		}
		.cta-bar__call {
			flex: none;
			display: grid;
			place-items: center;
			width: 54px;
			height: 54px;
			border-radius: 50%;
			border: 2px solid var(--sv-deep);
			color: var(--sv-deep);
		}
		.cta-bar__wa {
			flex: 1;
			min-height: 54px;
			justify-content: center;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cta-bar {
			transition: none;
		}
	}
	@media print {
		.cta-bar {
			display: none !important;
		}
	}
</style>
