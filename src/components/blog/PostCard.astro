---
/** Tarjeta de artículo del blog. */
import { Image } from "emdash/ui";
import { ROUTES } from "../../lib/routes";
import { icon } from "../../lib/icons";

interface Props {
	entry: { id: string; data: Record<string, any> };
	headingLevel?: "h2" | "h3";
}
const { entry, headingLevel: H = "h3" } = Astro.props;
const d = entry.data;
const category = d.terms?.category?.[0];
const date = d.publishedAt ? new Date(d.publishedAt).toLocaleDateString("es-CO", { day: "numeric", month: "long", year: "numeric", timeZone: "America/Bogota" }) : "";
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-card border border-line bg-surface shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lift">
	<div class="relative overflow-hidden">
		{d.featured_image ? <Image image={d.featured_image} class="aspect-[16/9] w-full object-cover transition duration-700 group-hover:scale-[1.04]" loading="lazy" sizes="(min-width:1024px) 30vw, (min-width:768px) 45vw, 92vw" /> : <div class="aspect-[16/9] bg-mist" />}
		{category && <span class="absolute top-4 left-4 rounded-full bg-deep/80 px-3 py-1 text-sm font-semibold text-white backdrop-blur">{category.label}</span>}
	</div>
	<div class="flex flex-1 flex-col p-6">
		<H class="font-display text-[1.35rem] leading-snug font-medium text-deep">
			<a href={ROUTES.posts(entry.id)} class="after:absolute after:inset-0">{d.title}</a>
		</H>
		{d.excerpt && <p class="mt-3 line-clamp-3 flex-1 text-muted">{d.excerpt}</p>}
		<p class="mt-5 flex items-center gap-2 text-sm text-muted">
			{date && <time datetime={new Date(d.publishedAt).toISOString()}>{date}</time>}
			{d.reading_minutes ? <span aria-hidden="true">·</span> : null}
			{d.reading_minutes ? <span>{d.reading_minutes} min de lectura</span> : null}
			<span class="ml-auto text-primary" set:html={icon("flecha-derecha", "size-5")} />
		</p>
	</div>
</article>
