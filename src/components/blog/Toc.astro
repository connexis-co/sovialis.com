---
/** Índice del artículo a partir de los H2 del contenido. */
import { slugify } from "emdash";
interface Props {
	content: any[] | null | undefined;
}
const { content } = Astro.props;
const items = (Array.isArray(content) ? content : [])
	.filter((b) => b?._type === "block" && b.style === "h2")
	.map((b) => {
		const text = (b.children ?? []).map((c: any) => c.text ?? "").join("");
		return { text, id: slugify(text) };
	})
	.filter((i) => i.text);
if (items.length < 2) return null;
---

<nav aria-labelledby="toc-title" class="toc rounded-card border border-line bg-surface p-5">
	<p id="toc-title" class="text-sm font-bold tracking-wider text-muted uppercase">En esta guía</p>
	<ol class="mt-3 grid gap-2 text-[0.98rem]">
		{
			items.map((i, n) => (
				<li class="flex gap-2.5">
					<span class="font-display text-primary">{String(n + 1).padStart(2, "0")}</span>
					<a href={`#${i.id}`} class="text-deep underline-offset-4 hover:text-primary hover:underline">
						{i.text}
					</a>
				</li>
			))
		}
	</ol>
</nav>
