---
/**
 * Cabecera de página sin hero: migas, antetítulo, H1 (con palabras destacadas opcionales), resumen,
 * botones de contacto opcionales y la S del isotipo como marca de agua sobre un degradado de marca.
 */
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import BrandS from "../ui/BrandS.astro";
import Cta from "../ui/Cta.astro";
import { icon } from "../../lib/icons";
import { getSiteData } from "../../lib/site";
import type { Crumb } from "../../layouts/Base.astro";

interface Props {
	title: string;
	summary?: string | null;
	eyebrow?: string | null;
	highlight?: string | null;
	crumbs?: Crumb[];
	/** Muestra WhatsApp + cotizar bajo el resumen. */
	actions?: boolean;
	/** Puntos de confianza bajo los botones. */
	chips?: string[];
	/** Anotaciones del modo de edición de EmDash para título y resumen. */
	edit?: { title?: object; summary?: object };
}
const { title, summary, eyebrow, highlight, crumbs = [], actions = false, chips = [], edit = {} } = Astro.props;
const site = actions ? await getSiteData() : null;
const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
const titleHtml = (() => {
	const hl = String(highlight ?? "");
	const i = hl ? title.toLowerCase().indexOf(hl.toLowerCase()) : -1;
	return i < 0 ? esc(title) : `${esc(title.slice(0, i))}<span class="hl">${esc(title.slice(i, i + hl.length))}</span>${esc(title.slice(i + hl.length))}`;
})();
---

<section class="page-header relative isolate overflow-hidden">
	<div class="page-header__glow" aria-hidden="true"></div>
	<BrandS class="pointer-events-none absolute -top-[14%] right-[-3rem] -z-10 hidden h-[132%] w-auto text-primary opacity-[0.07] sm:block lg:right-[6%]" />
	<div class="container-page relative pt-7 pb-12 lg:pt-10 lg:pb-16">
		{crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
		<div class="max-w-4xl">
			{eyebrow && <p class="eyebrow mt-7 animate-fade-up">{eyebrow}</p>}
			<h1 class="mt-4 font-display text-h1 text-deep animate-fade-up" set:html={titleHtml} {...edit.title} />
			{summary && <p class="mt-5 max-w-3xl text-lead text-muted" {...edit.summary}>{summary}</p>}
			{
				site && (
					<div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
						<Cta label="Escríbenos por WhatsApp" action="whatsapp" cta="cabecera:primario" site={site} heroSentinel />
						<Cta label={site.headerCta} action="cotizar" cta="cabecera:secundario" site={site} variant="outline" />
					</div>
				)
			}
			{
				chips.length > 0 && (
					<ul class="mt-7 flex flex-wrap gap-2.5">
						{chips.map((c) => (
							<li class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3.5 py-1.5 text-[0.95rem] font-semibold text-deep backdrop-blur">
								<span class="text-primary" set:html={icon("check", "size-4")} />
								{c}
							</li>
						))}
					</ul>
				)
			}
		</div>
	</div>
</section>

<style>
	.page-header {
		background: var(--sv-surface-warm);
		border-bottom: 1px solid var(--sv-border);
	}
	.page-header__glow {
		position: absolute;
		inset: 0;
		z-index: -20;
		background:
			radial-gradient(42% 70% at 88% 18%, color-mix(in oklab, var(--sv-secondary) 22%, transparent) 0%, transparent 70%),
			radial-gradient(38% 60% at 70% 100%, color-mix(in oklab, var(--sv-primary) 12%, transparent) 0%, transparent 70%),
			radial-gradient(30% 50% at 0% 0%, var(--sv-surface-alt) 0%, transparent 70%);
	}
</style>
