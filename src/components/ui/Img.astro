---
/**
 * Imagen de la biblioteca de medios de EmDash servida directamente desde R2 (los archivos ya se suben
 * optimizados en WebP). Con PUBLIC_CF_IMAGES=on genera srcset con las transformaciones de Cloudflare
 * (/cdn-cgi/image) cuando estén activas en la zona.
 */
interface ImageValue {
	src?: string;
	url?: string;
	alt?: string;
	width?: number;
	height?: number;
	meta?: { storageKey?: string };
	storageKey?: string;
}
interface Props {
	image: ImageValue | string | null | undefined;
	alt?: string;
	class?: string;
	sizes?: string;
	priority?: boolean;
	loading?: "lazy" | "eager";
	widths?: number[];
}
const { image, alt, class: className, sizes = "100vw", priority = false, loading, widths = [480, 768, 1080, 1440, 1920] } = Astro.props;
if (!image) return null;
const value: ImageValue = typeof image === "string" ? { src: image } : image;
const key = value.meta?.storageKey ?? value.storageKey;
const src = value.src || value.url || (key ? `/_emdash/api/media/file/${key}` : "");
if (!src) return null;
const transforms = import.meta.env.PUBLIC_CF_IMAGES === "on" && src.startsWith("/");
const max = value.width ?? 1920;
const srcset = transforms
	? widths
			.filter((w) => w <= max)
			.map((w) => `/cdn-cgi/image/width=${w},format=auto,quality=78${src} ${w}w`)
			.join(", ")
	: undefined;
---

<img
	src={src}
	srcset={srcset}
	sizes={srcset ? sizes : undefined}
	alt={alt ?? value.alt ?? ""}
	width={value.width}
	height={value.height}
	class={className}
	loading={priority ? "eager" : (loading ?? "lazy")}
	decoding={priority ? "sync" : "async"}
	fetchpriority={priority ? "high" : undefined}
/>
