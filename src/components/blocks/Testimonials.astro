---
/** Testimonios. Solo se publican testimonios reales con consentimiento; sin elementos, no se muestra. */
import SectionHead from "../ui/SectionHead.astro";
import { icon } from "../../lib/icons";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
const items: any[] = (Array.isArray(v.items) ? v.items : []).filter((t: any) => t?.quote);
if (!items.length) return null;
---

<section class="section bg-sand" data-block="testimonials">
	<div class="container-page">
		<SectionHead eyebrow={v.eyebrow} title={v.title} highlight={v.highlight} />
		<ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				items.map((t) => (
					<li class="reveal card flex flex-col p-7">
						<span class="text-primary/40" set:html={icon("cita", "size-9")} />
						{t.rating ? (
							<p class="mt-3 flex gap-1 text-[#e8a33d]" aria-label={`${t.rating} de 5 estrellas`}>
								{Array.from({ length: 5 }, (_, i) => <span set:html={icon("estrella", `size-5 ${i < t.rating ? "fill-current" : "opacity-30"}`)} />)}
							</p>
						) : null}
						<blockquote class="mt-4 flex-1 text-[1.12rem] leading-relaxed text-deep">«{t.quote}»</blockquote>
						<p class="mt-6 font-semibold text-deep">
							{t.author}
							<span class="block font-normal text-muted">{[t.relation, t.zone].filter(Boolean).join(" · ")}</span>
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
