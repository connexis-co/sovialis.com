---
/** Preguntas frecuentes con <details name> (una abierta a la vez, sin JS). Alimenta el FAQPage del JSON-LD. */
import SectionHead from "../ui/SectionHead.astro";

interface Props {
	value: { eyebrow?: string; title?: string; highlight?: string; subtitle?: string; items?: Array<{ question: string; answer: string }> };
	index?: number;
}
const { value: v, index = 0 } = Astro.props;
const items = (v.items ?? []).filter((i) => i?.question && i?.answer);
if (!items.length) return null;
const group = `faq-${index}`;
const answerHtml = (text: string) =>
	text
		.split(/\n{2,}/)
		.map((p) => `<p>${p.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!).replace(/\n/g, "<br>").replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")}</p>`)
		.join("");
---

<section class="section" data-block="faq" id="preguntas-frecuentes">
	<div class="container-page grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
		<div class="lg:sticky lg:top-28 lg:self-start">
			<SectionHead eyebrow={v.eyebrow || "Preguntas frecuentes"} title={v.title} highlight={v.highlight} subtitle={v.subtitle} align="left" />
		</div>
		<div class="faq-list">
			{
				items.map((it, i) => (
					<details class="faq" name={group} open={i === 0}>
						<summary>
							<h3 class="font-display text-[1.25rem] leading-snug font-medium text-deep">{it.question}</h3>
							<span class="faq__toggle" aria-hidden="true" />
						</summary>
						<div class="faq__answer prose-sv" set:html={answerHtml(it.answer)} />
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq {
		border-bottom: 1px solid var(--sv-border);
	}
	.faq summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 1.4rem 0;
		cursor: pointer;
		list-style: none;
	}
	.faq summary::-webkit-details-marker {
		display: none;
	}
	.faq__toggle {
		position: relative;
		flex: none;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 50%;
		border: 1.5px solid var(--sv-deep);
		transition: background var(--sv-dur), transform var(--sv-dur-reveal) var(--sv-ease-out);
	}
	.faq__toggle::before,
	.faq__toggle::after {
		content: "";
		position: absolute;
		inset: 50% auto auto 50%;
		width: 0.95rem;
		height: 1.5px;
		background: var(--sv-deep);
		transform: translate(-50%, -50%);
		transition: transform var(--sv-dur-reveal) var(--sv-ease-out), background var(--sv-dur);
	}
	.faq__toggle::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}
	.faq[open] .faq__toggle {
		background: var(--sv-deep);
	}
	.faq[open] .faq__toggle::before,
	.faq[open] .faq__toggle::after {
		background: #fff;
	}
	.faq[open] .faq__toggle::after {
		transform: translate(-50%, -50%) rotate(0deg);
	}
	.faq__answer {
		padding: 0 3.5rem 1.6rem 0;
		color: var(--sv-text-muted);
	}
	.faq summary:hover h3 {
		color: var(--sv-primary);
	}
	@supports (interpolate-size: allow-keywords) {
		.faq {
			interpolate-size: allow-keywords;
		}
		.faq::details-content {
			height: 0;
			overflow: clip;
			transition:
				height var(--sv-dur-reveal) var(--sv-ease-out),
				content-visibility var(--sv-dur-reveal) allow-discrete;
		}
		.faq[open]::details-content {
			height: auto;
		}
	}
</style>
