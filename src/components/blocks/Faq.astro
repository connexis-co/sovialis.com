---
/** Preguntas frecuentes: título centrado arriba y acordeón <details name> centrado debajo (una abierta a la vez, sin JS). Alimenta el FAQPage del JSON-LD. */
import SectionHead from "../ui/SectionHead.astro";

interface Props {
	value: { eyebrow?: string; title?: string; highlight?: string; subtitle?: string; items?: Array<{ question: string; answer: string }> };
	index?: number;
	/** Anotación del modo de edición de EmDash (clic → editor de las preguntas). */
	edit?: object;
}
const { value: v, index = 0, edit } = Astro.props;
const items = (v.items ?? []).filter((i) => i?.question && i?.answer);
if (!items.length) return null;
const group = `faq-${index}`;
const answerHtml = (text: string) =>
	text
		.split(/\n{2,}/)
		.map((p) => `<p>${p.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!).replace(/\n/g, "<br>").replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")}</p>`)
		.join("");
---

<section class="section" data-block="faq" id="preguntas-frecuentes" {...edit}>
	<div class="container-page">
		<SectionHead eyebrow={v.eyebrow || "Preguntas frecuentes"} title={v.title} highlight={v.highlight} subtitle={v.subtitle} />
		<div class="faq-list mx-auto mt-10 max-w-[52rem]">
			{
				items.map((it, i) => (
					<details class="faq" name={group} open={i === 0}>
						<summary>
							<h3 class="font-display text-[1.15rem] leading-snug font-medium text-deep sm:text-[1.25rem]">{it.question}</h3>
							<span class="faq__toggle" aria-hidden="true" />
						</summary>
						<div class="faq__answer prose-sv" set:html={answerHtml(it.answer)} />
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq {
		padding-inline: clamp(1.1rem, 3vw, 1.6rem);
		background: var(--sv-surface);
		border: 1px solid var(--sv-border);
		border-radius: 20px;
		transition:
			border-color var(--sv-dur) var(--sv-ease-out),
			box-shadow var(--sv-dur) var(--sv-ease-out);
	}
	.faq + .faq {
		margin-top: 12px;
	}
	.faq[open] {
		border-color: color-mix(in oklab, var(--sv-primary) 30%, var(--sv-border));
		box-shadow: var(--sv-shadow-md);
	}
	.faq summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 1.2rem 0;
		cursor: pointer;
		list-style: none;
	}
	.faq summary::-webkit-details-marker {
		display: none;
	}
	.faq__toggle {
		position: relative;
		flex: none;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 50%;
		border: 1.5px solid var(--sv-deep);
		transition: background var(--sv-dur), transform var(--sv-dur-reveal) var(--sv-ease-out);
	}
	.faq__toggle::before,
	.faq__toggle::after {
		content: "";
		position: absolute;
		inset: 50% auto auto 50%;
		width: 0.95rem;
		height: 1.5px;
		background: var(--sv-deep);
		transform: translate(-50%, -50%);
		transition: transform var(--sv-dur-reveal) var(--sv-ease-out), background var(--sv-dur);
	}
	.faq__toggle::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}
	.faq[open] .faq__toggle {
		background: var(--sv-deep);
	}
	.faq[open] .faq__toggle::before,
	.faq[open] .faq__toggle::after {
		background: #fff;
	}
	.faq[open] .faq__toggle::after {
		transform: translate(-50%, -50%) rotate(0deg);
	}
	.faq__answer {
		padding: 0 0 1.4rem;
		color: var(--sv-text-muted);
	}
	@media (min-width: 640px) {
		.faq__answer {
			padding-inline-end: 3.5rem;
		}
	}
	.faq summary:hover h3 {
		color: var(--sv-primary);
	}
	@supports (interpolate-size: allow-keywords) {
		.faq {
			interpolate-size: allow-keywords;
		}
		.faq::details-content {
			height: 0;
			overflow: clip;
			transition:
				height var(--sv-dur-reveal) var(--sv-ease-out),
				content-visibility var(--sv-dur-reveal) allow-discrete;
		}
		.faq[open]::details-content {
			height: auto;
		}
	}
</style>
