---
/** Tabla comparativa (p. ej. Sovialis vs. contratar directo vs. hogar geriátrico). */
import SectionHead from "../ui/SectionHead.astro";
import { icon } from "../../lib/icons";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
const rows: any[] = Array.isArray(v.rows) ? v.rows : [];
if (!rows.length) return null;
const cell = (text: string) => {
	const t = String(text ?? "").trim();
	if (/^(sí|si|✓)$/i.test(t)) return `${icon("check", "size-5 text-success mx-auto")}<span class="sr-only">Sí</span>`;
	if (/^(no|✕|x)$/i.test(t)) return `${icon("cerrar", "size-5 text-[#9a3346] mx-auto")}<span class="sr-only">No</span>`;
	return t.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!);
};
---

<section class="section bg-mist" data-block="comparison">
	<div class="container-page">
		<SectionHead eyebrow={v.eyebrow} title={v.title} highlight={v.highlight} subtitle={v.subtitle} />
		{/* En móvil cada aspecto es una tarjeta con las opciones una debajo de otra (sin scroll lateral). */}
		<div class="cmp reveal mx-auto mt-10 max-w-5xl sm:mt-12 sm:overflow-x-auto sm:rounded-card sm:border sm:border-line sm:bg-surface sm:shadow-lift">
			<table class="w-full border-collapse text-left sm:min-w-[40rem]">
				<thead>
					<tr>
						<th scope="col" class="p-5 text-sm font-bold tracking-wider text-muted uppercase">Aspecto</th>
						<th scope="col" class="bg-deep p-5 text-center font-display text-lg font-medium text-white">{v.col_a}</th>
						{v.col_b && <th scope="col" class="p-5 text-center font-display text-lg font-medium text-deep">{v.col_b}</th>}
						{v.col_c && <th scope="col" class="p-5 text-center font-display text-lg font-medium text-deep">{v.col_c}</th>}
					</tr>
				</thead>
				<tbody>
					{rows.map((r) => (
						<tr class="border-t border-line">
							<th scope="row" class="p-5 font-semibold text-deep">{r.feature}</th>
							<td class="cmp__main bg-primary/5 p-5 text-center font-semibold text-deep" data-label={v.col_a} set:html={cell(r.a)} />
							{v.col_b && <td class="p-5 text-center text-muted" data-label={v.col_b} set:html={cell(r.b)} />}
							{v.col_c && <td class="p-5 text-center text-muted" data-label={v.col_c} set:html={cell(r.c)} />}
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
</section>

<style>
	@media (max-width: 639px) {
		.cmp table,
		.cmp tbody,
		.cmp tr {
			display: block;
		}
		.cmp thead {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}
		.cmp tbody {
			display: grid;
			gap: 0.85rem;
		}
		.cmp tr {
			padding: 0.5rem;
			border: 1px solid var(--sv-border);
			border-radius: calc(var(--sv-radius) * 0.85);
			background: var(--sv-surface);
			box-shadow: var(--sv-shadow-sm);
		}
		.cmp th[scope="row"] {
			display: block;
			padding: 0.55rem 0.6rem 0.65rem;
			font-family: var(--sv-font-display);
			font-size: 1.08rem;
			font-weight: 500;
			line-height: 1.3;
		}
		.cmp td {
			display: grid;
			grid-template-columns: minmax(6.5rem, 38%) minmax(0, 1fr);
			gap: 0.75rem;
			align-items: center;
			padding: 0.7rem 0.6rem;
			border-top: 1px dashed var(--sv-border);
			text-align: left;
			font-size: 0.96rem;
			line-height: 1.4;
		}
		.cmp td::before {
			content: attr(data-label);
			font-size: 0.78rem;
			font-weight: 700;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--sv-text-muted);
		}
		.cmp td.cmp__main {
			border-top: 0;
			border-radius: 12px;
		}
		.cmp td.cmp__main::before {
			color: var(--sv-primary);
		}
		.cmp td.cmp__main + td {
			border-top: 0;
		}
		.cmp td :global(svg) {
			margin-inline: 0;
		}
	}
</style>
