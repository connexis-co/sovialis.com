---
/**
 * Layout base: <head> con SEO de EmDash + plugins, cabecera, pie, menú móvil, modal de cotización,
 * tarjeta Open Graph por página y scripts globales (todo sin frameworks).
 */
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { getSiteSettings } from "emdash";
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileMenu from "../components/layout/MobileMenu.astro";
import QuoteDialog from "../components/forms/QuoteDialog.astro";
import { getCatalog, getSiteData } from "../lib/site";

export interface Crumb {
	name: string;
	url: string;
}

interface Props {
	title: string;
	description?: string | null;
	image?: string | null;
	pageType?: string;
	content?: { collection: string; id: string; slug?: string | null };
	breadcrumbs?: Crumb[];
	robots?: string | null;
	article?: { publishedTime?: string | null; modifiedTime?: string | null; author?: string | null };
	/** Landing de campaña: cabecera reducida y barra móvil siempre visible. */
	campaign?: boolean;
	/** Preseleccionar servicio o zona en el modal de cotización. */
	quoteService?: string;
	quoteZone?: string;
	preloadImage?: string | null;
}

const {
	title,
	description,
	image,
	pageType = "website",
	content,
	breadcrumbs,
	robots,
	article,
	campaign = false,
	quoteService,
	quoteZone,
	preloadImage,
} = Astro.props;

const [site, catalog, settings] = await Promise.all([getSiteData(), getCatalog(), getSiteSettings().catch(() => ({}))]);
const separator = (settings as { seo?: { titleSeparator?: string } }).seo?.titleSeparator?.trim() || "|";
const fullTitle = title.includes(site.name) ? title : `${title} ${separator} ${site.name}`;
const origin = Astro.site?.origin ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).toString();
// Tarjeta OG generada en el despliegue (scripts/build-og.mjs): servicios, zonas y guías tienen la suya
// (con precio «desde» en servicios); el resto usa la general. Sin manifiesto, la imagen de la página.
type OgCard = { src: string; alt: string; width: number; height: number };
const ogManifest = (Object.values(import.meta.glob<{ default: Record<string, OgCard> }>("../data/og-manifest.json", { eager: true }))[0]?.default ?? {}) as Record<string, OgCard>;
const ogCard = (content?.slug && content.collection !== "pages" ? ogManifest[`${content.collection}/${content.slug}`] : undefined) ?? ogManifest["pages/default"];
const imageAbs = ogCard
	? new URL(ogCard.src, origin).toString()
	: image
		? new URL(image, origin).toString()
		: new URL("/og/sovialis-og.jpg", origin).toString();

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType,
	title: fullTitle,
	pageTitle: title,
	description: description ?? undefined,
	canonical,
	image: imageAbs,
	content: content ? { collection: content.collection, id: content.id, slug: content.slug ?? null } : undefined,
	seo: { robots: robots ?? null },
	siteName: site.name,
	articleMeta: article,
	breadcrumbs: breadcrumbs?.map((c) => ({ name: c.name, url: new URL(c.url, origin).toString() })),
	siteUrl: origin,
} as Parameters<typeof createPublicPageContext>[0]);
---

<!doctype html>
<html lang="es-CO" data-page-type={pageType}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{fullTitle}</title>
		<meta name="theme-color" content="#0b2a4e" />
		<meta name="format-detection" content="telephone=no" />
		<meta property="og:locale" content="es_CO" />
		<link rel="preload" href="/fonts/atkinson-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/jost-latin.woff2" as="font" type="font/woff2" crossorigin />
		{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="alternate" type="application/rss+xml" title="Blog de Sovialis" href="/blog/rss.xml" />
		<EmDashHead page={pageCtx} />
		{
			ogCard && (
				<>
					<meta property="og:image:type" content="image/jpeg" />
					<meta property="og:image:width" content={String(ogCard.width)} />
					<meta property="og:image:height" content={String(ogCard.height)} />
					<meta property="og:image:alt" content={ogCard.alt} />
					<meta name="twitter:image:alt" content={ogCard.alt} />
				</>
			)
		}
	</head>
	<body class:list={["min-h-dvh bg-canvas text-ink antialiased", campaign && "is-campaign"]}>
		<EmDashBodyStart page={pageCtx} />
		<a href="#contenido" class="sr-only z-[100] rounded-btn bg-deep px-5 py-3 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3">
			Saltar al contenido
		</a>
		<Header site={site} services={catalog.services} zones={catalog.zones} campaign={campaign} />
		<main id="contenido" tabindex="-1" class="outline-none">
			<slot />
		</main>
		<Footer site={site} services={catalog.services} zones={catalog.zones} />
		<MobileMenu site={site} services={catalog.services} zones={catalog.zones} />
		<QuoteDialog site={site} services={catalog.services} zones={catalog.zones} service={quoteService} zone={quoteZone} />
		<EmDashBodyEnd page={pageCtx} />
		<script>
			import "../scripts/site";
		</script>
	</body>
</html>
