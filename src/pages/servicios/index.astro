---
/** Hub de servicios: entrada «servicios» de Páginas (bloques) con respaldo automático. */
import { getEmDashEntry } from "emdash";
import Base from "../../layouts/Base.astro";
import Blocks from "../../components/blocks/Blocks.astro";
import Faq from "../../components/blocks/Faq.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import ServicesGrid from "../../components/blocks/ServicesGrid.astro";
import ClosingCta from "../../components/page/ClosingCta.astro";

const { entry, cacheHint } = await getEmDashEntry("pages", "servicios");
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
const d = (entry?.data ?? {}) as Record<string, any>;
const blocks: any[] = Array.isArray(d.layout) ? d.layout : [];
const crumbs = [
	{ name: "Inicio", url: "/" },
	{ name: "Servicios", url: "/servicios/" },
];
const startsWithHero = blocks[0]?._type === "hero";
---

<Base
	title={d.seo?.title || d.title || "Servicios de cuidado del adulto mayor"}
	description={d.seo?.description || d.summary}
	pageType="collection"
	content={entry ? { collection: "pages", id: d.id, slug: "servicios" } : undefined}
	breadcrumbs={crumbs}
	robots={d.seo?.noIndex ? "noindex,follow" : undefined}
>
	{!startsWithHero && <PageHeader title={d.title || "Servicios de cuidado del adulto mayor en casa"} summary={d.summary} crumbs={crumbs} eyebrow="Servicios" actions />}
	{blocks.length ? <Blocks blocks={blocks} offset={startsWithHero ? 0 : 1} /> : <ServicesGrid value={{ title: "Nuestros servicios" }} />}
	{d.faqs?.length > 0 && !blocks.some((b) => b._type === "faq") && <Faq value={{ title: "Preguntas frecuentes sobre los servicios", items: d.faqs }} index={99} />}
	{!blocks.some((b) => b._type === "cta_band") && <ClosingCta />}
</Base>
