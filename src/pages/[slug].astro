---
/** Páginas institucionales y legales (colección Páginas). */
import { getEmDashEntry } from "emdash";
import Prose from "../components/ui/Prose.astro";
import Base from "../layouts/Base.astro";
import Blocks from "../components/blocks/Blocks.astro";
import Faq from "../components/blocks/Faq.astro";
import PageHeader from "../components/page/PageHeader.astro";
import { HOME_SLUG } from "../lib/routes";

const { slug } = Astro.params;
if (!slug || slug === HOME_SLUG) return Astro.redirect("/", 301);
const { entry, cacheHint } = await getEmDashEntry("pages", slug);
if (!entry) return Astro.rewrite("/404/");
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
const d = entry.data as Record<string, any>;
const blocks: any[] = Array.isArray(d.layout) ? d.layout : [];
const startsWithHero = blocks[0]?._type === "hero";
const hasFaqBlock = blocks.some((b) => b._type === "faq");
const crumbs = [
	{ name: "Inicio", url: "/" },
	{ name: d.title, url: `/${slug}/` },
];
const isLegal = /politica|terminos|cookies/.test(slug);
---

<Base title={d.title} description={d.summary} pageType={isLegal ? "webpage" : slug === "contacto" ? "contact" : slug === "nosotros" ? "about" : "webpage"} content={{ collection: "pages", id: d.id, slug }} breadcrumbs={crumbs}>
	{!startsWithHero && <PageHeader title={d.title} summary={d.summary} crumbs={crumbs} eyebrow={isLegal ? "Información legal" : "Sovialis"} actions={!isLegal} />}
	<Blocks blocks={blocks} offset={startsWithHero ? 0 : 1} />
	{
		d.body?.length > 0 && (
			<section class="section-tight">
				<div class="container-page max-w-3xl">
					<div class="prose-sv">
						<Prose value={d.body} />
					</div>
				</div>
			</section>
		)
	}
	{!hasFaqBlock && d.faqs?.length > 0 && <Faq value={{ title: "Preguntas frecuentes", items: d.faqs }} index={99} />}
</Base>
