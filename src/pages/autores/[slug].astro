---
/** Perfil de autor (ProfilePage + Person en el JSON-LD) con sus guías. */
import { getBylineBySlug, getEntriesByByline } from "emdash";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import { ROUTES } from "../../lib/routes";

const { slug } = Astro.params;
const byline = slug ? await getBylineBySlug(slug).catch(() => null) : null;
if (!byline) return Astro.rewrite("/404/");
const posts = await (getEntriesByByline as any)("posts", byline.id).catch(() => []);
const entries = (Array.isArray(posts) ? posts : (posts?.entries ?? [])) as any[];
const crumbs = [
	{ name: "Inicio", url: "/" },
	{ name: "Guías", url: "/blog/" },
	{ name: byline.displayName, url: `/autores/${slug}/` },
];
---

<Base title={`${byline.displayName}: autor de guías`} description={byline.bio ?? `Guías escritas por ${byline.displayName}.`} pageType="author" breadcrumbs={crumbs}>
	<PageHeader title={byline.displayName} summary={byline.bio} crumbs={crumbs} eyebrow="Autor" />
	{/* Lista compacta (sin resúmenes ni fotos): con tarjetas repetía el 80 % del contenido de /blog/. */}
	<section class="section-tight">
		<div class="container-page max-w-3xl">
			<h2 class="font-display text-h3 text-deep">Guías publicadas ({entries.length})</h2>
			<ol class="mt-6 divide-y divide-line rounded-card border border-line bg-surface shadow-soft">
				{
					entries.map((p) => (
						<li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-5 py-4">
							<a href={ROUTES.posts(p.id)} class="font-semibold text-deep hover:text-primary hover:underline">
								{p.data?.title}
							</a>
							{p.data?.publishedAt && (
								<time class="text-sm text-muted" datetime={new Date(p.data.publishedAt).toISOString()}>
									{new Date(p.data.publishedAt).toLocaleDateString("es-CO", { day: "numeric", month: "short", year: "numeric", timeZone: "America/Bogota" })}
								</time>
							)}
						</li>
					))
				}
			</ol>
		</div>
	</section>
</Base>
