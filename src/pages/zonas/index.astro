---
/** Hub de zonas («norte de Bogotá»): entrada «zonas» de Páginas con mapa y lista automática. */
import { getEmDashEntry } from "emdash";
import Base from "../../layouts/Base.astro";
import Blocks from "../../components/blocks/Blocks.astro";
import Faq from "../../components/blocks/Faq.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import ZonesGrid from "../../components/blocks/ZonesGrid.astro";
import ClosingCta from "../../components/page/ClosingCta.astro";

const { entry, cacheHint } = await getEmDashEntry("pages", "zonas");
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
const d = (entry?.data ?? {}) as Record<string, any>;
const blocks: any[] = Array.isArray(d.layout) ? d.layout : [];
const crumbs = [
	{ name: "Inicio", url: "/" },
	{ name: "Zonas", url: "/zonas/" },
];
const startsWithHero = blocks[0]?._type === "hero";
---

<Base
	title={d.seo?.title || d.title || "Cuidado del adulto mayor en el norte de Bogotá"}
	description={d.seo?.description || d.summary}
	pageType="collection"
	content={entry ? { collection: "pages", id: d.id, slug: "zonas" } : undefined}
	breadcrumbs={crumbs}
>
	{!startsWithHero && <PageHeader title={d.title || "Cuidado del adulto mayor a domicilio en Bogotá"} summary={d.summary} crumbs={crumbs} eyebrow="Zonas de cobertura" actions />}
	{blocks.length ? <Blocks blocks={blocks} offset={startsWithHero ? 0 : 1} /> : <ZonesGrid value={{ title: "Zonas donde cuidamos" }} index={1} />}
	{d.faqs?.length > 0 && <Faq value={{ title: "Preguntas sobre la cobertura", items: d.faqs }} index={99} />}
	{!blocks.some((b) => b._type === "cta_band") && <ClosingCta />}
</Base>
